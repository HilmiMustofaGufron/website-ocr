# Salin berkas ini menjadi ".env" untuk mengubah pengaturan. SEMUA BARIS BERSIFAT OPSIONAL: nilai bawaan sudah
# sesuai hasil pengujian. Berkas ".env" berisi rahasia, jangan dibagikan atau dikirim ke siapa pun.

# --- Akun awal (hanya dipakai saat aplikasi pertama kali dijalankan dan belum ada pengguna) ---
# Bila ADMIN_PASSWORD dikosongkan, dibuat password acak yang dicetak SEKALI di terminal dan disimpan di instance/kredensial_awal.txt
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- Jaringan ---
# HOST=0.0.0.0        # 0.0.0.0 = bisa dibuka dari perangkat lain di jaringan yang sama; 127.0.0.1 = hanya komputer ini
# PORT=5000

# --- Model YOLO ---
# MODEL_YOLO_PATH=models_ai/best_lokasi_new.pt

# --- Pembacaan kode (nilai yang diuji; jangan diubah tanpa menguji ulang) ---
# AMBANG_TERIMA_JARAK=2.0
# MAX_DIMENSI_PROSES=1600

# --- Keamanan ---
# SECRET_KEY=            # kosong = dibuat otomatis sekali dan disimpan di instance/secret_key
# FLASK_DEBUG=0          # JANGAN dinyalakan di jaringan: debugger yang terbuka berbahaya
# SESSION_COOKIE_SECURE=0  # isi 1 hanya bila diakses lewat HTTPS
